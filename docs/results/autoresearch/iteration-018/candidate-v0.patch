index 0000000..18596de
--- /dev/null
+++ b/flex_gemm/tenstorrent/_k6.py
@@ -0,0 +1,188 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Pinned Apache-2.0 K6 layer adapted for FlexGEMM digit products.
+
+See K6-NOTICE. The integer weights and zero bias are supplied by digit_implicit;
+there is no model loader, encoder or feature cache here. Only HiFi3 is enabled.
+"""
+from __future__ import annotations
+
+import os
+from typing import Any, Dict, List, Optional, Tuple
+
+
+__all__ = ["K6Layer", "CB_BUDGET"]
+
+_KDIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "kernels", "k6")
+TB32, TB16 = 4096, 2048
+N_RT = 1
+N_RT_READER = 8
+# fp32 weight tiles resident per chunk (112 x 4 KB = 448 KB): l1-l3 and conv_out in one chunk, down3 in 2, l4 in 4
+WEIGHT_BUDGET_TILES = 112
+# total circular-buffer bytes per core a layer may use (the L1 tables of K6_TABLES=l1 sit above the CB region): taps
+# per chunk shrink until the layer's CBs fit
+CB_BUDGET = 900 * 1024
+
+
+class K6Layer:
+    """One sparse conv layer of a :class:`ttaw.models.sparse_encoder.SparseConvSpec` as the K6 ``generic_op``."""
+
+    def __init__(self, spec: Any, *, budget_tiles: int = WEIGHT_BUDGET_TILES):
+        self.spec = spec
+        self.fidelity = "HiFi3"
+        self.name = spec.name
+        self.K = spec.kernel_volume
+        self.cin_t = spec.cin_pad // 32
+        self.cout_t = spec.cout_pad // 32
+        self.budget_tiles = int(budget_tiles)
+        # weights read once per grid row and multicast along it
+        self.mcast = True
+        # both data-movement RISCs gather (the writer the odd-rank present taps)
+        self.split = True
+        self.tg, self.nch = self.plan(0)
+        self._dev: Optional[Tuple[Any, Any]] = None
+
+    def cb_bytes(self, tg: int, nch: int, nbmax: int, has_res: bool = True, write_y: bool = True) -> int:
+        """Circular-buffer bytes per core of the layer (the descriptor in :meth:`__call__`)."""
+        ci, co, K = self.cin_t, self.cout_t, self.K
+        b = 2 * tg * ci * TB16 + tg * ci * co * TB32 + co * TB32 + 4 * 32 + tg * ci * TB16 + 2 * K * 128 + 4 * 32 \
+            + co * 64 + ci * TB16 + 2 * co * TB16
+        b += 2 * co * TB32 if has_res else 0
+        b += nbmax * co * TB32 if nch > 1 else 0
+        b += 2 * co * TB32 if write_y else 0
+        b += 2 * tg * ci * TB16 + 2 * K * 128 + ci * TB16 if self.split else 0
+        return b
+
+    def plan(self, nbmax: int) -> Tuple[int, int]:
+        """(taps per chunk, chunks): the fewest chunks whose weights fit ``budget_tiles`` and whose CBs fit
+        :data:`CB_BUDGET` with ``nbmax`` blocks per core."""
+        per_tap = self.cin_t * self.cout_t
+        nch = max(1, -(-self.K * per_tap // self.budget_tiles))
+        while True:
+            tg = -(-self.K // nch)
+            n = -(-self.K // tg)
+            if tg == 1 or self.cb_bytes(tg, n, nbmax) <= CB_BUDGET:
+                return tg, n
+            nch += 1
+
+    def _upload(self, device: Any) -> Tuple[Any, Any]:
+        if self._dev is None:
+            raise ValueError("digit weights must be prepared before K6 execution")
+        return self._dev
+
+    def __call__(self, table: Any, index: Any, identity: Any = None, write_y: bool = False, dead_skip: bool = True,
+                 table_memory: str = "dram"):
+        """``table`` bf16 ROW_MAJOR ``[1, 1, V + 1, cin_pad]`` (row V zero), ``index`` uint32 ROW_MAJOR
+        ``[rows / 32, K * 32]`` (C13 tile order), ``identity`` fp32 TILE ``[1, 1, rows, cout_pad]`` or None ->
+        ``(y, table_out)``: y the fp32 TILE output (``write_y``; else None) and the next bf16 ROW_MAJOR table
+        ``[1, 1, rows + 1, cout_pad]`` (zero last row). ``dead_skip``: only live blocks' rows are written (else
+        all-sentinel blocks are computed as the stock layer does: every row written, deterministic)."""
+        import ttnn
+
+        spec = self.spec
+        dev = table.device()
+        if int(table.shape[-1]) != spec.cin_pad:
+            raise ValueError(f"{self.name}: table width {int(table.shape[-1])} != {spec.cin_pad}")
+        if int(index.shape[-1]) != self.K * 32:
+            raise ValueError(f"{self.name}: index has {int(index.shape[-1])} columns, expected {self.K * 32}")
+        nblk = int(index.shape[0])
+        rows = nblk * 32
+        sent = int(table.shape[-2]) - 1
+        has_res = identity is not None
+        w, b = self._upload(dev)
+        tmc = ttnn.L1_MEMORY_CONFIG if table_memory == "l1" else ttnn.DRAM_MEMORY_CONFIG
+        out = ttnn.allocate_tensor_on_device(ttnn.Shape([1, 1, rows + 1, spec.cout_pad]), ttnn.bfloat16,
+                                             ttnn.ROW_MAJOR_LAYOUT, dev, tmc)
+        y = None
+        if write_y:
+            y = ttnn.allocate_tensor_on_device(ttnn.Shape([1, 1, rows, spec.cout_pad]), ttnn.float32,
+                                               ttnn.TILE_LAYOUT, dev, ttnn.DRAM_MEMORY_CONFIG)
+        g = dev.compute_with_storage_grid_size()
+        nc = int(g.x) * int(g.y)
+        crs = ttnn.CoreRangeSet({ttnn.CoreRange(ttnn.CoreCoord(0, 0), ttnn.CoreCoord(g.x - 1, g.y - 1))})
+        mcast = self.mcast and int(g.x) > 1
+        rd, wr, cp = ttnn.RuntimeArgs(), ttnn.RuntimeArgs(), ttnn.RuntimeArgs()
+        for i in range(nc):
+            cx, cy = i % g.x, i // g.x
+            s_ = dev.worker_core_from_logical_core(ttnn.CoreCoord(0, cy))
+            a_ = dev.worker_core_from_logical_core(ttnn.CoreCoord(1 if g.x > 1 else 0, cy))
+            b_ = dev.worker_core_from_logical_core(ttnn.CoreCoord(g.x - 1, cy))
+            rd[cx][cy] = [i, int(cx == 0), s_.x, s_.y, a_.x, a_.y, b_.x, b_.y]
+            wr[cx][cy] = [i]
+            cp[cx][cy] = [i]
+        nbmax = -(-nblk // nc)
+        tg, nch = self.plan(nbmax)
+        self.tg, self.nch = tg, nch
+        K, cin_t, cout_t = self.K, self.cin_t, self.cout_t
+
+        def cb(idx, pages, dtype, size):
+            return ttnn.CBDescriptor(total_size=pages * size, core_ranges=crs, format_descriptors=[
+                ttnn.CBFormatDescriptor(buffer_index=idx, data_format=dtype, page_size=size)])
+
+        cbs = [cb(0, 2 * tg * cin_t, ttnn.bfloat16, TB16),               # gathered tap rows (row-major)
+               cb(1, tg * cin_t * cout_t, ttnn.float32, TB32),           # the chunk's weights
+               cb(2, cout_t, ttnn.float32, TB32),                        # bias tiles
+               cb(4, 4, ttnn.float32, 32),                               # meta (compute)
+               cb(5, tg * cin_t, ttnn.bfloat16, TB16),                   # tilized taps
+               cb(7, 2, ttnn.float32, K * 128),                          # reader's index rows (double buffer)
+               cb(8, 4, ttnn.float32, 32),                               # meta (writer)
+               cb(9, 1, ttnn.bfloat16, cout_t * 64),                     # the zero row (core 0)
+               cb(10, 1, ttnn.bfloat16, cin_t * TB16),                   # reader's zero tap region
+               cb(16, 2 * cout_t, ttnn.bfloat16, TB16)]                  # untilized output rows
+        if has_res:
+            cbs.append(cb(3, 2 * cout_t, ttnn.float32, TB32))
+        if nch > 1:
+            cbs.append(cb(6, nbmax * cout_t, ttnn.float32, TB32))       # fp32 partials between chunks
+        if write_y:
+            cbs.append(cb(17, 2 * cout_t, ttnn.float32, TB32))
+        split = self.split
+        if split:
+            cbs += [cb(11, 2 * tg * cin_t, ttnn.bfloat16, TB16),            # the writer's gathered tap rows
+                    cb(12, 2, ttnn.float32, K * 128),                      # the writer's index rows
+                    cb(13, 1, ttnn.bfloat16, cin_t * TB16)]                # the writer's zero tap region
+        um = [ttnn.UnpackToDestMode.Default] * 64
+        for i in (2, 3, 6):
+            um[i] = ttnn.UnpackToDestMode.UnpackToDestFp32
+        ccfg = ttnn.ComputeConfigDescriptor(math_fidelity=getattr(ttnn.MathFidelity, self.fidelity), fp32_dest_acc_en=True,
+                                            math_approx_mode=False)
+        ccfg.unpack_to_dest_mode = um
+        SRC = ttnn.KernelDescriptor.SourceType.FILE_PATH
+
+        def acc(t):
+            return list(ttnn.TensorAccessorArgs(t).get_compile_time_args())
+
+
+        def kd(name, ct, rt, common, config):
+            return ttnn.KernelDescriptor(kernel_source=os.path.join(_KDIR, name), source_type=SRC, core_ranges=crs,
+                                         compile_time_args=ct, defines=[], runtime_args=rt,
+                                         common_runtime_args=common, config=config)
+
+        ident = identity if has_res else w
+        yt = y if write_y else out
+        rd_ct = [N_RT_READER, K, cin_t, cout_t, nch, tg, nblk, nc, sent, int(has_res), int(bool(dead_skip)),
+                 int(mcast), int(g.x) - 1, int(split)] + acc(table) + acc(index) + acc(w) \
+            + acc(b) + acc(ident)
+        wr_ct = [N_RT, cout_t, nblk, nc, rows, int(bool(write_y)), int(split), K, cin_t, nch, tg, sent,
+                 int(bool(dead_skip))] + acc(out) + acc(yt) + acc(table) + acc(index)
+        cp_ct = [N_RT, K, cin_t, cout_t, nch, tg, nblk, nc, int(has_res), int(bool(write_y)), int(bool(spec.relu)),
+                 int(split)]
+        ks = [kd("k6_reader.cpp", rd_ct, rd, [table.buffer_address(), index.buffer_address(), w.buffer_address(),
+                                              b.buffer_address(), ident.buffer_address()],
+                 ttnn.ReaderConfigDescriptor()),
+              kd("k6_writer.cpp", wr_ct, wr, [out.buffer_address(), yt.buffer_address(), table.buffer_address(),
+                                              index.buffer_address()],
+                 ttnn.WriterConfigDescriptor()),
+              kd("k6_compute.cpp", cp_ct, cp, [], ccfg)]
+        ios: List[Any] = [table, index, w, b]
+        if has_res:
+            ios.append(identity)
+        if write_y:
+            ios.append(y)
+        ios.append(out)
+        sems = [ttnn.SemaphoreDescriptor(id=0, core_ranges=crs, initial_value=0),
+                ttnn.SemaphoreDescriptor(id=1, core_ranges=crs, initial_value=0)]
+        ttnn.generic_op(ios, ttnn.ProgramDescriptor(kernels=ks, semaphores=sems, cbs=cbs))
+        return y, out
+
+    def describe(self) -> Dict[str, Any]:
+        return {"name": self.name, "kernel": "k6", "K": self.K, "cin_t": self.cin_t, "cout_t": self.cout_t,
+                "taps_per_chunk": self.tg, "chunks": self.nch}
diff --git a/flex_gemm/tenstorrent/digit_implicit.py b/flex_gemm/tenstorrent/digit_implicit.py
new file mode 100644
index 0000000..4d402d7
--- /dev/null
+++ b/flex_gemm/tenstorrent/digit_implicit.py
@@ -0,0 +1,153 @@
+"""Opt-in four-product implicit convolution with a bounded explicit fallback."""
+
+from dataclasses import dataclass
+from types import SimpleNamespace
+
+import torch
+
+from .digits import SparseDigitWeights, _copy_output_rows, _feature_digits, _scale_and_bias
+from .implicit import _round32
+
+
+@dataclass
+class DigitImplicitPlan:
+    info: dict
+    chunks: tuple = ()
+
+
+def index_rows(mapping, input_rows):
+    """K6 page order: output-row tile, kernel tap, row within tile."""
+    rows, volume = mapping.shape
+    padded = torch.full((_round32(rows), volume), input_rows, dtype=torch.int64)
+    padded[:rows] = torch.where(mapping < 0, input_rows, mapping)
+    return padded.reshape(-1, 32, volume).permute(0, 2, 1).reshape(-1, volume * 32).to(torch.uint32)
+
+
+def prepare_sparse_digit_implicit(weights, topology, *, row_chunk=256):
+    """Prepare only immutable weights, integer indices and shape-dependent plans.
+
+    A topology owns its index/plan cache; different same-shaped topologies never
+    share it. Weights own their two K6 layers. Calling this ahead of a forward
+    separates static preparation from hot execution. Unsupported shapes retain
+    the exact explicit digit implementation and expose the fallback reason.
+    """
+    import ttnn
+    from ._k6 import CB_BUDGET, K6Layer
+    if not isinstance(weights, SparseDigitWeights) or topology.masks is not None:
+        raise ValueError("implicit digits require digit weights and unmasked topology")
+    if (topology.device != weights.device or topology.host_indices.shape[1] != weights.volume):
+        raise ValueError("weights and topology must share a device and kernel volume")
+    if not isinstance(row_chunk, int) or isinstance(row_chunk, bool) or row_chunk < 1:
+        raise ValueError("row_chunk must be a positive integer")
+    key = (weights.ci, weights.co, weights.volume, row_chunk)
+    if key in topology.digit_plans:
+        plan = topology.digit_plans[key]
+        if plan.info["path"] == "digit_implicit_gemm" and not weights.implicit_layers:
+            _prepare_layers(weights, plan.info["multicast"])
+        return plan
+    device = weights.device
+    grid = device.compute_with_storage_grid_size()
+    info = {"path": "digit_implicit_gemm", "reason": None, "row_chunk": row_chunk,
+            "grid": [grid.x, grid.y], "cb_budget_bytes": CB_BUDGET, "chunks": [],
+            "product_calls": 4, "weight_storage": "FP32 encoding of BF16 integer digits",
+            "unused_bf16_output_included": True}
+
+    def fallback(reason):
+        info.update(path="digit_explicit_gemm", reason=reason)
+        plan = DigitImplicitPlan(info)
+        topology.digit_plans[key] = plan
+        return plan
+
+    if device.arch() != ttnn.Arch.WORMHOLE_B0:
+        return fallback("architecture")
+    if weights.volume > 32:
+        return fallback("kernel_volume_exceeds_32")
+    if row_chunk % 32:
+        return fallback("row_chunk_not_tile_aligned")
+    layer = K6Layer(_spec(weights))
+    rows = len(topology.host_indices)
+    for start in range(0, rows, row_chunk):
+        end = min(start + row_chunk, rows)
+        nbmax = (_round32(end - start) // 32 + grid.x * grid.y - 1) // (grid.x * grid.y)
+        tg, nch = layer.plan(nbmax)
+        cb_bytes = layer.cb_bytes(tg, nch, nbmax, has_res=False, write_y=True)
+        info["chunks"].append({"start": start, "end": end, "tap_chunk": tg,
+                               "tap_chunks": nch, "cb_bytes": cb_bytes})
+        if cb_bytes > CB_BUDGET:
+            return fallback("per_core_cb_budget")
+    physical = [[device.worker_core_from_logical_core(ttnn.CoreCoord(x, y))
+                 for x in range(grid.x)] for y in range(grid.y)]
+    multicast = all(all(row[x].x == row[0].x + x and row[x].y == row[0].y
+                        for x in range(grid.x)) for row in physical)
+    info.update(multicast=multicast, split_gather=True,
+                physical_core_rows=[[[c.x, c.y] for c in row] for row in physical])
+    _prepare_layers(weights, multicast)
+    chunks = []
+    for chunk in info["chunks"]:
+        start, end = chunk["start"], chunk["end"]
+        ids = index_rows(topology.host_indices[start:end], topology.input_points)
+        index = ttnn.from_torch(ids, dtype=ttnn.uint32, layout=ttnn.ROW_MAJOR_LAYOUT,
+                               device=device, memory_config=ttnn.DRAM_MEMORY_CONFIG)
+        chunks.append((start, end, index))
+    plan = DigitImplicitPlan(info, tuple(chunks))
+    topology.digit_plans[key] = plan
+    return plan
+
+
+def _spec(weights):
+    return SimpleNamespace(name="flexgemm_integer_product", cin=weights.ci, cout=weights.co,
+        cin_pad=_round32(weights.ci), cout_pad=_round32(weights.co),
+        kernel_volume=weights.volume, relu=False, out_terms=1)
+
+
+def _prepare_layers(weights, multicast):
+    import ttnn
+    from ._k6 import K6Layer
+    if weights.implicit_layers:
+        return
+    spec = _spec(weights)
+    zero_bias = ttnn.zeros([32, spec.cout_pad], dtype=ttnn.float32, layout=ttnn.TILE_LAYOUT,
+                           device=weights.device, memory_config=ttnn.DRAM_MEMORY_CONFIG)
+    layers = []
+    for digit in weights.digits:
+        layer = K6Layer(spec)
+        layer.mcast = multicast
+        layer._dev = (ttnn.typecast(digit.weights, ttnn.float32), zero_bias)
+        layers.append(layer)
+    weights.implicit_layers = tuple(layers)
+
+
+def sparse_digit_implicit_conv_device(features, weights, topology, *, row_chunk=256, fp32_output=False):
+    import ttnn
+    plan = prepare_sparse_digit_implicit(weights, topology, row_chunk=row_chunk)
+    if plan.info["path"] == "digit_explicit_gemm":
+        from .digits import sparse_digit_conv_device
+        return sparse_digit_conv_device(features, weights, topology,
+                                         row_chunk=row_chunk, fp32_output=fp32_output)
+    high, low, feature_scale = _feature_digits(features, _round32(weights.ci))
+    scale = ttnn.multiply(ttnn.repeat(feature_scale, [1, weights.co]), weights.scale)
+    scale_tile = ttnn.multiply(weights.scale_tile, feature_scale)
+    output = ttnn.allocate_tensor_on_device(ttnn.Shape([len(topology.host_indices), weights.co]),
+        ttnn.float32 if fp32_output else ttnn.bfloat16, ttnn.TILE_LAYOUT,
+        weights.device, ttnn.DRAM_MEMORY_CONFIG)
+    for start, end, index in plan.chunks:
+        def product(table, digit):
+            y, unused = weights.implicit_layers[digit](table, index, identity=None,
+                write_y=True, dead_skip=False, table_memory="dram")
+            del unused
+            return ttnn.reshape(y, [index.shape[0] * 32, _round32(weights.co)])
+
+        top = product(high, 0)
+        cross_a, cross_b = product(high, 1), product(low, 0)
+        cross = ttnn.add(cross_a, cross_b)
+        del cross_a, cross_b
+        bottom = product(low, 1)
+        result = ttnn.add(ttnn.add(top, ttnn.multiply(cross, 1 / 256)), ttnn.multiply(bottom, 1 / 65536))
+        del top, cross, bottom
+        result = ttnn.slice(result, [0, 0], [end - start, weights.co])
+        result = _scale_and_bias(result, weights, scale, scale_tile)
+        if not fp32_output:
+            result = ttnn.typecast(result, ttnn.bfloat16)
+        _copy_output_rows(result, output, start)
+        del result
+    return output
