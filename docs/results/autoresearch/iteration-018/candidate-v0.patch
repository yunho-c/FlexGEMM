diff --git a/flex_gemm/tenstorrent/kernels/k6/k6_compute.cpp b/flex_gemm/tenstorrent/kernels/k6/k6_compute.cpp
new file mode 100644
index 0000000..cc24122
--- /dev/null
+++ b/flex_gemm/tenstorrent/kernels/k6/k6_compute.cpp
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: Apache-2.0
+// K6 implicit-GEMM sparse conv (tt/sparse_k6.py, OPT_PLAN K6), compute.
+//
+// Per (chunk, live block of this core): tilize the present taps' gathered rows (CB_GATH, row-major [32, CIN_T * 32]
+// per tap) into CB_TL at slot p * CIN_T (CB_TL always takes TG * CIN_T pages per block: fixed increments), then for
+// each output tile n: DEST[0] (+)= sum over present taps p, input tiles c of TL[p, c] x W[p, c, n] (fp32 weights,
+// HiFi4, fp32 DEST, tap-major / channel order = the stock im2col matmul's K order). Between chunks the fp32 partial
+// goes through CB_ACC (UnpackToDestFp32 reload: exact). Last chunk, the epilogue in the order of the stock programs:
+//   y = acc + bias                       add_binary_tile<NearestEven> (binary_ng's fp32 SFPU add)
+//   y = y + identity     (HAS_RES)       add_binary_tile<NearestEven>
+//   y = relu(y)          (RELU)          relu_tile
+//   CB_Y <- y            (WRITE_Y)       fp32 tile (the residual source / tap)
+//   out = bf16(y)                        typecast_tile<Float32, Float16_b> (ttnn.typecast), packed untilized into
+//                                        CB_OUT (32 rows x COUT_T * 32 bf16, row-major: the next table's rows)
+// CT args: [0] per-core RT-arg count (P3) [1] K [2] CIN_T [3] COUT_T [4] NCH [5] TG [6] NBLK [7] NC [8] HAS_RES
+//          [9] WRITE_Y [10] RELU [11] SPLIT (odd-rank present taps come from CB_GATH2, the writer's gathers). Per-core RT args: [me].
+#include <cstdint>
+
+#include "api/compute/common.h"
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/copy_dest_values.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/eltwise_unary/eltwise_unary.h"
+#include "api/compute/eltwise_unary/fill.h"
+#include "api/compute/eltwise_unary/relu.h"
+#include "api/compute/eltwise_unary/typecast.h"
+#include "api/compute/matmul.h"
+#include "api/compute/pack_untilize.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/compute/tile_move_copy.h"
+#include "api/compute/tilize.h"
+
+using namespace ckernel;
+
+constexpr uint32_t K = get_compile_time_arg_val(1);
+constexpr uint32_t CIN_T = get_compile_time_arg_val(2);
+constexpr uint32_t COUT_T = get_compile_time_arg_val(3);
+constexpr uint32_t NCH = get_compile_time_arg_val(4);
+constexpr uint32_t TG = get_compile_time_arg_val(5);
+constexpr uint32_t NBLK = get_compile_time_arg_val(6);
+constexpr uint32_t NC = get_compile_time_arg_val(7);
+constexpr uint32_t HAS_RES = get_compile_time_arg_val(8);
+constexpr uint32_t WRITE_Y = get_compile_time_arg_val(9);
+constexpr uint32_t RELU = get_compile_time_arg_val(10);
+constexpr uint32_t SPLIT = get_compile_time_arg_val(11);
+
+constexpr uint32_t CB_GATH = 0, CB_W = 1, CB_BIAS = 2, CB_IDENT = 3, CB_META = 4, CB_TL = 5, CB_ACC = 6;
+constexpr uint32_t CB_GATH2 = 11, CB_OUT = 16, CB_Y = 17;
+constexpr uint32_t WCH = TG * CIN_T * COUT_T;
+constexpr uint32_t TLN = TG * CIN_T;
+
+void kernel_main() {
+    const uint32_t me = get_arg_val<uint32_t>(0);
+    compute_kernel_hw_startup<SrcOrder::Reverse>(CB_TL, CB_W, CB_OUT);
+    // BH: the DEST remap of pack-untilize is a MATH-thread setting; arm it once here, outside any DEST section (as
+    // the stock matmul's untilize_out path leaves it armed for its later matmuls)
+    pack_untilize_dest_init<1, COUT_T>(CB_OUT);
+    pack_untilize_uninit(CB_OUT);
+    cb_wait_front(CB_BIAS, COUT_T);
+
+    for (uint32_t ch = 0; ch < NCH; ++ch) {
+        const uint32_t t0 = ch * TG;
+        const uint32_t nt = (K - t0) < TG ? (K - t0) : TG;
+        const bool last = ch == NCH - 1;
+        cb_wait_front(CB_W, WCH);
+        for (uint32_t b = me; b < NBLK; b += NC) {
+            cb_wait_front(CB_META, 1);
+            UNPACK(asm volatile("fence"));
+            const uint32_t mask = read_tile_value(CB_META, 0, 0);
+            const uint32_t live = read_tile_value(CB_META, 0, 1);
+            cb_pop_front(CB_META, 1);
+            if (!live) {
+                continue;
+            }
+            // ---- tilize the present taps
+            cb_reserve_back(CB_TL, TLN);
+            if (mask) {
+                reconfig_data_format_srca(CB_GATH);
+                pack_reconfig_data_format(CB_TL);
+                tilize_init(CB_GATH, CIN_T, CB_TL);
+                uint32_t k = 0;
+                for (uint32_t p = 0; p < nt; ++p) {
+                    if (mask & (1u << p)) {
+                        const uint32_t cb = (SPLIT && (k & 1)) ? CB_GATH2 : CB_GATH;
+                        ++k;
+                        cb_wait_front(cb, CIN_T);
+#ifndef K6_NOTILIZE
+                        tilize_block(cb, CIN_T, CB_TL, 0, p * CIN_T);
+#endif
+                        cb_pop_front(cb, CIN_T);
+                    }
+                }
+                tilize_uninit(CB_GATH, CB_TL);
+            }
+            cb_push_back(CB_TL, TLN);
+            cb_wait_front(CB_TL, TLN);
+            if (last) {
+                cb_reserve_back(CB_OUT, COUT_T);
+                if constexpr (HAS_RES) {
+                    cb_wait_front(CB_IDENT, COUT_T);
+                }
+            }
+            for (uint32_t n = 0; n < COUT_T; ++n) {
+                tile_regs_acquire();
+                if (ch > 0) {
+                    reconfig_data_format_srca(CB_ACC);
+                    copy_tile_init(CB_ACC);
+                    cb_wait_front(CB_ACC, 1);
+                    copy_tile(CB_ACC, 0, 0);
+                    cb_pop_front(CB_ACC, 1);
+                } else {
+                    // DEST is not guaranteed zero here (pack-untilize does not clear it): start from +0
+                    fill_tile_init();
+                    fill_tile(0, 0.0f);
+                }
+                reconfig_data_format_srca(CB_W);
+                reconfig_data_format_srcb(CB_TL);
+                matmul_init(CB_TL, CB_W);
+                for (uint32_t p = 0; p < nt; ++p) {
+                    if (mask & (1u << p)) {
+#ifndef K6_NOMM
+                        for (uint32_t c = 0; c < CIN_T; ++c) {
+                            matmul_tiles(CB_TL, CB_W, p * CIN_T + c, (p * CIN_T + c) * COUT_T + n, 0);
+                        }
+#endif
+                    }
+                }
+                if (!last) {
+                    tile_regs_commit();
+                    cb_reserve_back(CB_ACC, 1);
+                    tile_regs_wait();
+                    pack_reconfig_data_format(CB_ACC);
+                    pack_tile(0, CB_ACC);
+                    tile_regs_release();
+                    cb_push_back(CB_ACC, 1);
+                    continue;
+                }
+                reconfig_data_format_srca(CB_BIAS);
+                copy_tile_init(CB_BIAS);
+                copy_tile(CB_BIAS, n, 1);
+                add_binary_tile_init();
+                add_binary_tile<ckernel::DstRoundingMode::NearestEven>(0, 1, 0);
+                if constexpr (HAS_RES) {
+                    reconfig_data_format_srca(CB_IDENT);
+                    copy_tile_init(CB_IDENT);
+                    copy_tile(CB_IDENT, n, 1);
+                    add_binary_tile_init();
+                    add_binary_tile<ckernel::DstRoundingMode::NearestEven>(0, 1, 0);
+                }
+                if constexpr (RELU) {
+                    relu_tile_init();
+                    relu_tile(0);
+                }
+                if constexpr (WRITE_Y) {
+                    copy_dest_values_init();
+                    copy_dest_values<DataFormat::Float32>(0, 2);
+                }
+                typecast_tile_init<(uint32_t)DataFormat::Float32, (uint32_t)DataFormat::Float16_b>();
+                typecast_tile<(uint32_t)DataFormat::Float32, (uint32_t)DataFormat::Float16_b>(0);
+                tile_regs_commit();
+                if constexpr (WRITE_Y) {
+                    cb_reserve_back(CB_Y, 1);
+                }
+                tile_regs_wait();
+                if constexpr (WRITE_Y) {
+                    pack_reconfig_data_format(CB_Y);
+                    pack_tile(2, CB_Y);
+                }
+                pack_reconfig_data_format(CB_OUT);
+                pack_untilize_dest_init<1, COUT_T, false, TILE_C_DIM, false, false>(CB_OUT);
+                pack_untilize_dest<1, COUT_T>(CB_OUT, 1, n);
+                pack_untilize_uninit(CB_OUT);
+                tile_regs_release();
+                if constexpr (WRITE_Y) {
+                    cb_push_back(CB_Y, 1);
+                }
+            }
+            if (last) {
+                cb_push_back(CB_OUT, COUT_T);
+                if constexpr (HAS_RES) {
+                    cb_pop_front(CB_IDENT, COUT_T);
+                }
+            }
+            cb_pop_front(CB_TL, TLN);
+        }
+        cb_pop_front(CB_W, WCH);
+    }
+    cb_pop_front(CB_BIAS, COUT_T);
+}
diff --git a/flex_gemm/tenstorrent/kernels/k6/k6_gather.hpp b/flex_gemm/tenstorrent/kernels/k6/k6_gather.hpp
new file mode 100644
index 0000000..6e0761d
--- /dev/null
+++ b/flex_gemm/tenstorrent/kernels/k6/k6_gather.hpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: Apache-2.0
+// K6 implicit-GEMM sparse conv (tt/sparse_k6.py): the gather steps shared by the reader (RISCV_1) and, with
+// SPLIT, the writer (RISCV_0), so both data-movement RISCs issue row reads (each on its own NoC).
+#pragma once
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+
+// live (any index of the block != SENT; always 1 without DEAD_SKIP) and the mask of the chunk's taps [t0, t0 + nt)
+// with any index != SENT. ip: the block's index row (K x 32, tap-major).
+template <uint32_t K, uint32_t SENT, uint32_t DEAD_SKIP>
+inline void k6_scan(const uint32_t* ip, uint32_t t0, uint32_t nt, uint32_t& live, uint32_t& mask) {
+    live = 1;
+    if constexpr (DEAD_SKIP) {
+        live = 0;
+        for (uint32_t i = 0; i < K * 32; ++i) {
+            if (ip[i] != SENT) {
+                live = 1;
+                break;
+            }
+        }
+    }
+    mask = 0;
+    if (live) {
+        for (uint32_t p = 0; p < nt; ++p) {
+            const uint32_t* q = ip + (t0 + p) * 32;
+            for (uint32_t v = 0; v < 32; ++v) {
+                if (q[v] != SENT) {
+                    mask |= (1u << p);
+                    break;
+                }
+            }
+        }
+    }
+}
+
+// The present taps of `mask` whose rank (order among the present taps) is = PART mod NPARTS: each tap's 32 rows of
+// CIN_T * 64 B into one CIN_T-page region of `cb` (the CB holds 2 TG CIN_T pages and every push is CIN_T pages, so
+// a region is contiguous; regions wrap at the CB end). (1) every region zeroed by one local NoC copy from `zero_noc`
+// (sentinel rows stay zero), barrier, (2) the rows' reads, `before_barrier()` (the index prefetch), barrier, pushes.
+template <uint32_t CIN_T, uint32_t ROWB, uint32_t SENT, uint32_t PART, uint32_t NPARTS, typename Acc, typename F>
+inline void k6_gather(const uint32_t* ip, uint32_t t0, uint32_t nt, uint32_t mask, uint32_t cb, uint64_t zero_noc,
+                      const Acc& tab, F&& before_barrier) {
+    uint32_t mine = 0;
+    {
+        uint32_t k = 0;
+        for (uint32_t p = 0; p < nt; ++p) {
+            if (mask & (1u << p)) {
+                if (k % NPARTS == PART) {
+                    mine |= (1u << p);
+                }
+                ++k;
+            }
+        }
+    }
+    const uint32_t np = __builtin_popcount(mine);
+    if (!np) {
+        before_barrier();
+        return;
+    }
+    cb_reserve_back(cb, np * CIN_T);
+    uint32_t wp = get_write_ptr(cb);
+    const uint32_t lim = get_local_cb_interface(cb).fifo_limit;
+    const uint32_t sz = get_local_cb_interface(cb).fifo_size;
+    uint32_t zp = wp;
+    for (uint32_t p = 0; p < np; ++p) {
+        noc_async_read(zero_noc, zp, CIN_T * 2048);
+        zp += CIN_T * 2048;
+        if (zp >= lim) {
+            zp -= sz;
+        }
+    }
+    noc_async_read_barrier();
+    for (uint32_t p = 0; p < nt; ++p) {
+        if (!(mine & (1u << p))) {
+            continue;
+        }
+        const uint32_t* q = ip + (t0 + p) * 32;
+        uint32_t rp = wp;
+        for (uint32_t v = 0; v < 32; ++v) {
+            const uint32_t r = q[v];
+            if (r != SENT) {
+#ifndef K6_NOREAD
+                noc_async_read(tab.get_noc_addr(r), rp, ROWB);
+#endif
+            }
+            rp += ROWB;
+        }
+        wp += CIN_T * 2048;
+        if (wp >= lim) {
+            wp -= sz;
+        }
+    }
+    before_barrier();
+    noc_async_read_barrier();
+    for (uint32_t p = 0; p < np; ++p) {
+        cb_push_back(cb, CIN_T);
+    }
+}
diff --git a/flex_gemm/tenstorrent/kernels/k6/k6_reader.cpp b/flex_gemm/tenstorrent/kernels/k6/k6_reader.cpp
new file mode 100644
index 0000000..355ab2c
--- /dev/null
+++ b/flex_gemm/tenstorrent/kernels/k6/k6_reader.cpp
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: Apache-2.0
+// K6 implicit-GEMM sparse conv (tt/sparse_k6.py, OPT_PLAN K6), reader (RISCV_0 / NCRISC).
+//
+// One layer y[o] = sum_k W_k^T x[nmap[o, k]] (+ bias, + identity, ReLU) over 32-row output blocks. Block b of this
+// core: b = me, me + NC, me + 2 NC, ... (strided, so the live blocks, a prefix of the level, spread over all cores).
+// Taps are processed in NCH chunks of TG taps (the chunk's fp32 weights resident in L1).
+//
+// Per chunk:  the chunk's weight tiles -> CB_W (always TG * CIN_T * COUT_T pages; the tail chunk part filled).
+// Per block:  the block's index row (K * 32 uint32, tile order: entry k * 32 + v = row of output 32 b + v at tap k)
+//             -> scratch; live = any entry != SENT (rows past the level count are all-sentinel: skipped whole);
+//             mask = taps of the chunk with any entry != SENT (all-sentinel taps contribute exact zeros: skipped).
+//             meta page {mask, live} -> CB_META (compute); in the last chunk {live} -> CB_WMETA (writer).
+//             For each tap in mask: CIN_T row-major pages = 32 table rows (CIN_T * 64 B each; sentinel rows zero)
+//             -> CB_GATH (one read barrier per block).
+//             Last chunk, HAS_RES: the COUT_T fp32 identity tiles of the block -> CB_IDENT.
+// Once:       the COUT_T fp32 bias tiles (rows replicated) -> CB_BIAS.
+//
+// CT args: [0] per-core RT-arg count (P3) [1] K [2] CIN_T [3] COUT_T [4] NCH [5] TG [6] NBLK [7] NC [8] SENT
+//          [9] HAS_RES [10] DEAD_SKIP (0: all-sentinel blocks are computed like the stock layer, relu(bias)
+//          (+ identity), so every output row is written and deterministic) [11] MCAST [12] NRECV
+//          [13] SPLIT (the writer gathers the odd-rank present taps into CB_GATH2; no CB_WMETA), then the TensorAccessorArgs of table, index, weight, bias, identity.
+// Common RT args: [table, index, weight, bias, identity]. Per-core RT args: [me, is_sender, sender x, y (virtual),
+// the receivers' rectangle x0, y0, x1, y1 (virtual, NOC 0 order)].
+// MCAST: the chunk's weights are read from DRAM once per grid row, by the row's first core, and multicast to the
+// NRECV other cores of the row (the stock 1D-matmul handshake: each receiver frees its CB_W, sets its 'valid'
+// semaphore to 0 and increments the sender's 'ready' semaphore; the sender waits for NRECV, multicasts the data,
+// flushes, then multicasts valid = 1). The rectangle never contains the sender.
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "k6_gather.hpp"
+
+constexpr uint32_t K = get_compile_time_arg_val(1);
+constexpr uint32_t CIN_T = get_compile_time_arg_val(2);
+constexpr uint32_t COUT_T = get_compile_time_arg_val(3);
+constexpr uint32_t NCH = get_compile_time_arg_val(4);
+constexpr uint32_t TG = get_compile_time_arg_val(5);
+constexpr uint32_t NBLK = get_compile_time_arg_val(6);
+constexpr uint32_t NC = get_compile_time_arg_val(7);
+constexpr uint32_t SENT = get_compile_time_arg_val(8);
+constexpr uint32_t HAS_RES = get_compile_time_arg_val(9);
+constexpr uint32_t DEAD_SKIP = get_compile_time_arg_val(10);
+constexpr uint32_t MCAST = get_compile_time_arg_val(11);
+constexpr uint32_t NRECV = get_compile_time_arg_val(12);
+constexpr uint32_t SPLIT = get_compile_time_arg_val(13);
+constexpr uint32_t NPARTS = SPLIT ? 2 : 1;
+constexpr auto t_args = TensorAccessorArgs<14>();
+constexpr auto i_args = TensorAccessorArgs<t_args.next_compile_time_args_offset()>();
+constexpr auto w_args = TensorAccessorArgs<i_args.next_compile_time_args_offset()>();
+constexpr auto b_args = TensorAccessorArgs<w_args.next_compile_time_args_offset()>();
+constexpr auto r_args = TensorAccessorArgs<b_args.next_compile_time_args_offset()>();
+
+constexpr uint32_t CB_GATH = 0, CB_W = 1, CB_BIAS = 2, CB_IDENT = 3, CB_META = 4, CB_IDX = 7, CB_WMETA = 8, CB_ZBUF = 10;
+constexpr uint32_t ROWB = CIN_T * 64;      // table row bytes (bf16)
+constexpr uint32_t IDXB = K * 32 * 4;      // index row bytes
+constexpr uint32_t TB32 = 4096;
+constexpr uint32_t WCH = TG * CIN_T * COUT_T;
+
+void kernel_main() {
+    const uint32_t me = get_arg_val<uint32_t>(0);
+    const uint32_t is_sender = get_arg_val<uint32_t>(1);
+    const uint32_t snx = get_arg_val<uint32_t>(2), sny = get_arg_val<uint32_t>(3);
+    // NOC 1 runs its coordinates the other way: the rectangle's start is the far corner there (as ttnn's matmuls)
+    const bool n1 = noc_index == 1;
+    const uint32_t mx0 = get_arg_val<uint32_t>(n1 ? 6 : 4), my0 = get_arg_val<uint32_t>(n1 ? 7 : 5);
+    const uint32_t mx1 = get_arg_val<uint32_t>(n1 ? 4 : 6), my1 = get_arg_val<uint32_t>(n1 ? 5 : 7);
+    const uint32_t ready_addr = get_semaphore(0);
+    const uint32_t valid_addr = get_semaphore(1);
+    volatile tt_l1_ptr uint32_t* ready_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(ready_addr);
+    volatile tt_l1_ptr uint32_t* valid_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(valid_addr);
+    const auto tab = TensorAccessor(t_args, get_common_arg_val<uint32_t>(0), ROWB);
+    const auto idx = TensorAccessor(i_args, get_common_arg_val<uint32_t>(1), IDXB);
+    const auto wt = TensorAccessor(w_args, get_common_arg_val<uint32_t>(2), TB32);
+    const auto bs = TensorAccessor(b_args, get_common_arg_val<uint32_t>(3), TB32);
+    const auto rs = TensorAccessor(r_args, get_common_arg_val<uint32_t>(4), TB32);
+
+    // bias once
+    cb_reserve_back(CB_BIAS, COUT_T);
+    {
+        uint32_t wp = get_write_ptr(CB_BIAS);
+        for (uint32_t n = 0; n < COUT_T; ++n) {
+            noc_async_read(bs.get_noc_addr(n), wp + n * TB32, TB32);
+        }
+        noc_async_read_barrier();
+    }
+    cb_push_back(CB_BIAS, COUT_T);
+
+    // a zeroed region of one tap (32 rows x CIN_T * 64 B): the source of the per-tap zero fills
+    cb_reserve_back(CB_ZBUF, 1);
+    const uint32_t zero_l1 = get_write_ptr(CB_ZBUF);
+    {
+        volatile tt_l1_ptr uint32_t* z = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(zero_l1);
+        for (uint32_t j = 0; j < CIN_T * 512; ++j) {
+            z[j] = 0;
+        }
+    }
+    const uint64_t zero_noc = get_noc_addr(zero_l1);
+
+    // two index-row buffers: the next (chunk, block)'s row is prefetched while this block gathers
+    cb_reserve_back(CB_IDX, 2);
+    const uint32_t idx_buf[2] = {get_write_ptr(CB_IDX), get_write_ptr(CB_IDX) + IDXB};
+    uint32_t cur = 0;
+    if (me < NBLK) {
+        noc_async_read(idx.get_noc_addr(me), idx_buf[0], IDXB);
+    }
+
+    for (uint32_t ch = 0; ch < NCH; ++ch) {
+        const uint32_t t0 = ch * TG;
+        const uint32_t nt = (K - t0) < TG ? (K - t0) : TG;
+        const bool last = ch == NCH - 1;
+        // weights of the chunk: tiles [t0 * CIN_T * COUT_T, (t0 + nt) * CIN_T * COUT_T)
+        cb_reserve_back(CB_W, WCH);
+        {
+            const uint32_t wp = get_write_ptr(CB_W);
+            const uint32_t first = t0 * CIN_T * COUT_T;
+            const uint32_t cnt = nt * CIN_T * COUT_T;
+            if (!MCAST || is_sender) {
+                for (uint32_t i = 0; i < cnt; ++i) {
+                    noc_async_read(wt.get_noc_addr(first + i), wp + i * TB32, TB32);
+                }
+                noc_async_read_barrier();
+            }
+            if constexpr (MCAST) {
+                if (is_sender) {
+                    noc_semaphore_wait(ready_ptr, NRECV);
+                    noc_semaphore_set(ready_ptr, 0);
+                    noc_async_write_multicast(wp, get_noc_multicast_addr(mx0, my0, mx1, my1, wp), cnt * TB32, NRECV,
+                                              true);
+                    noc_async_writes_flushed();
+                    *valid_ptr = 1;
+                    noc_semaphore_set_multicast(valid_addr, get_noc_multicast_addr(mx0, my0, mx1, my1, valid_addr),
+                                                NRECV);
+                    noc_async_write_barrier();
+                } else {
+                    noc_semaphore_set(valid_ptr, 0);
+                    noc_semaphore_inc(get_noc_addr(snx, sny, ready_addr), 1);
+                    noc_semaphore_wait(valid_ptr, 1);
+                }
+            }
+        }
+        cb_push_back(CB_W, WCH);
+
+        for (uint32_t b = me; b < NBLK; b += NC) {
+            noc_async_read_barrier();
+            invalidate_l1_cache();
+            asm volatile("" ::: "memory");
+            const uint32_t* ip = reinterpret_cast<const uint32_t*>(idx_buf[cur]);
+            bool prefetched = false;
+            auto prefetch = [&]() {
+                uint32_t nb = b + NC, nch = ch;
+                if (nb >= NBLK) {
+                    nb = me;
+                    ++nch;
+                }
+                if (nch < NCH) {
+                    noc_async_read(idx.get_noc_addr(nb), idx_buf[cur ^ 1], IDXB);
+                }
+                prefetched = true;
+            };
+            uint32_t live, mask;
+            k6_scan<K, SENT, DEAD_SKIP>(ip, t0, nt, live, mask);
+            cb_reserve_back(CB_META, 1);
+            {
+                volatile tt_l1_ptr uint32_t* mp = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_write_ptr(CB_META));
+                mp[0] = mask;
+                mp[1] = live;
+            }
+            cb_push_back(CB_META, 1);
+            if (last && !SPLIT) {
+                cb_reserve_back(CB_WMETA, 1);
+                volatile tt_l1_ptr uint32_t* mp = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_write_ptr(CB_WMETA));
+                mp[0] = live;
+                cb_push_back(CB_WMETA, 1);
+            }
+            if (!live) {
+                prefetch();
+                cur ^= 1;
+                continue;
+            }
+            // the present taps of rank 0 mod NPARTS (all of them without SPLIT; the writer gathers the others)
+            k6_gather<CIN_T, ROWB, SENT, 0, NPARTS>(ip, t0, nt, mask, CB_GATH, zero_noc, tab, prefetch);
+            if (!prefetched) {
+                prefetch();
+            }
+            if constexpr (HAS_RES) {
+                if (last) {
+                    // (the identity reads complete under the next block's barrier at the latest; push after ours)
+                    cb_reserve_back(CB_IDENT, COUT_T);
+                    uint32_t wp = get_write_ptr(CB_IDENT);
+                    for (uint32_t n = 0; n < COUT_T; ++n) {
+                        noc_async_read(rs.get_noc_addr(b * COUT_T + n), wp + n * TB32, TB32);
+                    }
+                    noc_async_read_barrier();
+                    cb_push_back(CB_IDENT, COUT_T);
+                }
+            }
+            cur ^= 1;
+        }
+    }
+    cb_push_back(CB_IDX, 2);
+    cb_push_back(CB_ZBUF, 1);
+}
diff --git a/flex_gemm/tenstorrent/kernels/k6/k6_writer.cpp b/flex_gemm/tenstorrent/kernels/k6/k6_writer.cpp
new file mode 100644
index 0000000..ef64819
--- /dev/null
+++ b/flex_gemm/tenstorrent/kernels/k6/k6_writer.cpp
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: Apache-2.0
+// K6 implicit-GEMM sparse conv (tt/sparse_k6.py, OPT_PLAN K6), writer (RISCV_0 / BRISC).
+// Core 0 first writes the zero sentinel row (page ROWS) of the output table. Then, for each block of this core (the
+// reader's order), a live block's COUT_T fp32 tiles (WRITE_Y) go to y (tile b * COUT_T + n) and its 32 untilized
+// bf16 rows (CB_OUT) to the output table (pages 32 b .. 32 b + 31). Dead blocks write nothing.
+// Without SPLIT the live flags come from the reader (CB_WMETA, last chunk). With SPLIT this kernel also walks every
+// (chunk, block), reads the index rows itself (prefetched, double-buffered), and gathers the present taps of odd rank
+// into CB_GATH2 (k6_gather.hpp); a block's outputs are written one block later, after the next block's gathers, so
+// the compute never waits for this RISC's writes.
+// CT args: [0] per-core RT-arg count (P3) [1] COUT_T [2] NBLK [3] NC [4] ROWS [5] WRITE_Y [6] SPLIT [7] K [8] CIN_T
+// [9] NCH [10] TG [11] SENT [12] DEAD_SKIP, then the TensorAccessorArgs of the output table, y, the input table and
+// the index. Common RT args: [table_out, y, table_in, index]. Per-core RT args: [me].
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "k6_gather.hpp"
+
+constexpr uint32_t COUT_T = get_compile_time_arg_val(1);
+constexpr uint32_t NBLK = get_compile_time_arg_val(2);
+constexpr uint32_t NC = get_compile_time_arg_val(3);
+constexpr uint32_t ROWS = get_compile_time_arg_val(4);
+constexpr uint32_t WRITE_Y = get_compile_time_arg_val(5);
+constexpr uint32_t SPLIT = get_compile_time_arg_val(6);
+constexpr uint32_t K = get_compile_time_arg_val(7);
+constexpr uint32_t CIN_T = get_compile_time_arg_val(8);
+constexpr uint32_t NCH = get_compile_time_arg_val(9);
+constexpr uint32_t TG = get_compile_time_arg_val(10);
+constexpr uint32_t SENT = get_compile_time_arg_val(11);
+constexpr uint32_t DEAD_SKIP = get_compile_time_arg_val(12);
+constexpr auto o_args = TensorAccessorArgs<13>();
+constexpr auto y_args = TensorAccessorArgs<o_args.next_compile_time_args_offset()>();
+constexpr auto t_args = TensorAccessorArgs<y_args.next_compile_time_args_offset()>();
+constexpr auto i_args = TensorAccessorArgs<t_args.next_compile_time_args_offset()>();
+
+constexpr uint32_t CB_WMETA = 8, CB_ZERO = 9, CB_GATH2 = 11, CB_IDX2 = 12, CB_ZBUF2 = 13, CB_OUT = 16, CB_Y = 17;
+constexpr uint32_t ROWB = COUT_T * 64;
+constexpr uint32_t ROWB_IN = CIN_T * 64;
+constexpr uint32_t IDXB = K * 32 * 4;
+constexpr uint32_t TB32 = 4096;
+
+template <typename OA, typename YA>
+inline void write_block(uint32_t b, const OA& out, const YA& yy) {
+    if constexpr (WRITE_Y) {
+        for (uint32_t n = 0; n < COUT_T; ++n) {
+            cb_wait_front(CB_Y, 1);
+            noc_async_write(get_read_ptr(CB_Y), yy.get_noc_addr(b * COUT_T + n), TB32);
+            noc_async_writes_flushed();
+            cb_pop_front(CB_Y, 1);
+        }
+    }
+    cb_wait_front(CB_OUT, COUT_T);
+    uint32_t rp = get_read_ptr(CB_OUT);
+    for (uint32_t v = 0; v < 32; ++v) {
+        noc_async_write(rp, out.get_noc_addr(b * 32 + v), ROWB);
+        rp += ROWB;
+    }
+    noc_async_writes_flushed();
+    cb_pop_front(CB_OUT, COUT_T);
+}
+
+void kernel_main() {
+    const uint32_t me = get_arg_val<uint32_t>(0);
+    const auto out = TensorAccessor(o_args, get_common_arg_val<uint32_t>(0), ROWB);
+    const auto yy = TensorAccessor(y_args, get_common_arg_val<uint32_t>(1), TB32);
+    if (me == 0) {
+        cb_reserve_back(CB_ZERO, 1);
+        const uint32_t zp = get_write_ptr(CB_ZERO);
+        volatile tt_l1_ptr uint32_t* z = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(zp);
+        for (uint32_t j = 0; j < ROWB / 4; ++j) {
+            z[j] = 0;
+        }
+        noc_async_write(zp, out.get_noc_addr(ROWS), ROWB);
+        noc_async_write_barrier();
+        cb_push_back(CB_ZERO, 1);
+    }
+    if constexpr (!SPLIT) {
+        for (uint32_t b = me; b < NBLK; b += NC) {
+            cb_wait_front(CB_WMETA, 1);
+            invalidate_l1_cache();
+            const uint32_t live = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_read_ptr(CB_WMETA))[0];
+            cb_pop_front(CB_WMETA, 1);
+            if (live) {
+                write_block(b, out, yy);
+            }
+        }
+    } else {
+        const auto tab = TensorAccessor(t_args, get_common_arg_val<uint32_t>(2), ROWB_IN);
+        const auto idx = TensorAccessor(i_args, get_common_arg_val<uint32_t>(3), IDXB);
+        cb_reserve_back(CB_ZBUF2, 1);
+        const uint32_t zero_l1 = get_write_ptr(CB_ZBUF2);
+        {
+            volatile tt_l1_ptr uint32_t* z = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(zero_l1);
+            for (uint32_t j = 0; j < CIN_T * 512; ++j) {
+                z[j] = 0;
+            }
+        }
+        const uint64_t zero_noc = get_noc_addr(zero_l1);
+        cb_reserve_back(CB_IDX2, 2);
+        const uint32_t idx_buf[2] = {get_write_ptr(CB_IDX2), get_write_ptr(CB_IDX2) + IDXB};
+        uint32_t cur = 0;
+        if (me < NBLK) {
+            noc_async_read(idx.get_noc_addr(me), idx_buf[0], IDXB);
+        }
+        uint32_t pending = NBLK;            // a live block of the last chunk whose outputs are still to be written
+        for (uint32_t ch = 0; ch < NCH; ++ch) {
+            const uint32_t t0 = ch * TG;
+            const uint32_t nt = (K - t0) < TG ? (K - t0) : TG;
+            const bool last = ch == NCH - 1;
+            for (uint32_t b = me; b < NBLK; b += NC) {
+                noc_async_read_barrier();
+                invalidate_l1_cache();
+                asm volatile("" ::: "memory");
+                const uint32_t* ip = reinterpret_cast<const uint32_t*>(idx_buf[cur]);
+                auto prefetch = [&]() {
+                    uint32_t nb = b + NC, nch = ch;
+                    if (nb >= NBLK) {
+                        nb = me;
+                        ++nch;
+                    }
+                    if (nch < NCH) {
+                        noc_async_read(idx.get_noc_addr(nb), idx_buf[cur ^ 1], IDXB);
+                    }
+                };
+                uint32_t live, mask;
+                k6_scan<K, SENT, DEAD_SKIP>(ip, t0, nt, live, mask);
+                if (live) {
+                    k6_gather<CIN_T, ROWB_IN, SENT, 1, 2>(ip, t0, nt, mask, CB_GATH2, zero_noc, tab, prefetch);
+                } else {
+                    prefetch();
+                }
+                cur ^= 1;
+                if (last && live) {
+                    if (pending != NBLK) {
+                        write_block(pending, out, yy);
+                    }
+                    pending = b;
+                }
+            }
+        }
+        if (pending != NBLK) {
+            write_block(pending, out, yy);
+        }
+        noc_async_read_barrier();
+        cb_push_back(CB_IDX2, 2);
+        cb_push_back(CB_ZBUF2, 1);
+    }
+    noc_async_write_barrier();
+}
