diff --git a/tests/tenstorrent/test_resident.py b/tests/tenstorrent/test_resident.py
index ab73278..05c2650 100644
--- a/tests/tenstorrent/test_resident.py
+++ b/tests/tenstorrent/test_resident.py
@@ -245,3 +245,41 @@ def test_digit_implicit_fp32_only_products_match_table_path(device,rows,ci,co,vo
                                                ttnn.to_torch(old).view(torch.int32),atol=0,rtol=0)
                     del old,unused,actual
         torch.testing.assert_close(ttnn.to_torch(resident),values,atol=0,rtol=0)
+
+
+@pytest.mark.parametrize('rows,ci,co,volume', [
+    (65, 17, 45, 27), (257, 128, 128, 27), (8193, 64, 64, 27), (1025, 128, 512, 27)])
+def test_digit_implicit_bf16_weights_match_fp32_products(device, rows, ci, co, volume):
+    import ttnn
+    from flex_gemm.tenstorrent._k6 import K6Layer
+    from flex_gemm.tenstorrent.digits import _feature_digits
+    g = torch.Generator().manual_seed(231)
+    inputs = rows + 19
+    mapping = torch.randint(-1, inputs, (rows, volume), generator=g)
+    mapping[:32] = -1
+    mapping[-1] = inputs - 1
+    weights = prepare_sparse_digit_weights(torch.randn(co, volume, ci, generator=g).bfloat16(), device=device)
+    topology = prepare_sparse_topology(mapping, inputs, device=device)
+    plan = prepare_sparse_digit_implicit(weights, topology, row_chunk=8192)
+    assert plan.info['path'] == 'digit_implicit_gemm' and plan.info['weight_tile_bytes'] == 2048
+    controls = []
+    for layer, digit in zip(weights.implicit_layers, weights.digits):
+        assert layer._dev[0].buffer_address() == digit.weights.buffer_address()
+        control = K6Layer(layer.spec)
+        control.mcast, control.split = layer.mcast, layer.split
+        control._dev = (ttnn.typecast(layer._dev[0], ttnn.float32), layer._dev[1])
+        controls.append(control)
+    original = torch.randn(inputs, ci, generator=g).bfloat16()
+    for values in (original, (original.float() * .5 + .03125).bfloat16()):
+        resident = ttnn.from_torch(values, device=device, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT)
+        high, low, scale = _feature_digits(resident, (ci + 31) // 32 * 32)
+        for _, _, index in plan.chunks:
+            for table in (high, low):
+                for layer, control in zip(weights.implicit_layers, controls):
+                    old, _ = control(table, index, write_y=True, dead_skip=False, write_table=False)
+                    actual, _ = layer(table, index, write_y=True, dead_skip=False, write_table=False)
+                    assert (layer.tg, layer.nch) == (control.tg, control.nch)
+                    torch.testing.assert_close(ttnn.to_torch(actual).view(torch.int32),
+                                               ttnn.to_torch(old).view(torch.int32), atol=0, rtol=0)
+                    del old, actual
+        torch.testing.assert_close(ttnn.to_torch(resident), values, atol=0, rtol=0)
